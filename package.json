{
  "name": "northern-information",
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run css:build && npx @11ty/eleventy && npm run pagefind",
    "clean": "rm -rf node_modules package-lock.json dist",
    "css": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./dist/styles/tailwind.css",
    "css:build": "npm run css -- --minify",
    "css:watch": "npm run css -- --watch",
    "dev": "concurrently 'npx @11ty/eleventy --serve --quiet' 'npm run css:watch'",
    "generate-release-posts": "node scripts/generate-release-posts.js",
    "images": "IMAGES_PROCESS=1 npx @11ty/eleventy --quiet && node scripts/upload-images.js",
    "images:download": "node scripts/download-images.js",
    "pagefind": "pagefind --site dist",
    "pretty": "prettier --write .",
    "test": "TZ=America/Los_Angeles node --test 'test/*.test.js'",
    "check:dist": "node scripts/check-dist.js",
    "check:repo": "node scripts/check-repo.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "7.1.1",
    "@tailwindcss/cli": "4.3.5",
    "@tyleretters/discography": "4.0.2",
    "concurrently": "10.0.6",
    "luxon": "3.7.2",
    "markdown-it": "15.0.3",
    "markdown-it-implicit-figures": "0.12.0",
    "memoize": "11.0.0",
    "pagefind": "1.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
