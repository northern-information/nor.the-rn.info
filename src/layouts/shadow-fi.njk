<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{% getTitle title %}</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content="{{ site.META.DESCRIPTION }}" />
    <link rel="canonical" href="{{ site.META.DOMAIN }}/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.META.TITLE }}" />
    <meta property="og:title" content="{{ site.META.TITLE }}" />
    <meta property="og:url" content="{{ site.META.DOMAIN }}/" />
    <meta property="og:description" content="{{ site.META.DESCRIPTION }}" />
    <meta
      property="og:image"
      content="{{ site.META.DOMAIN }}/{{ site.META.LOGO }}"
    />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ site.META.TITLE }}" />
    <meta name="twitter:description" content="{{ site.META.DESCRIPTION }}" />
    <meta
      name="twitter:image"
      content="{{ site.META.DOMAIN }}/{{ site.META.LOGO }}"
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style>
      @font-face {
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/ibm-plex-mono-latin-400-normal.woff2')
          format('woff2');
      }
      :root {
        color-scheme: dark;
        --sf-bg: #000000;
        --sf-text: #e5e5e5;
        --sf-dim: #9ca3af; /* gray-400 */
        --sf-ember: #fa9e3d;
        --sf-link: #fde047; /* yellow-300 */
        --sf-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco,
          Consolas, 'Liberation Mono', 'Courier New', monospace;
      }
      html,
      body {
        height: 100%;
        margin: 0;
        background: var(--sf-bg);
        color: var(--sf-text);
        font-family: var(--sf-mono);
        overflow: hidden;
      }
      #sf-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        display: block;
        touch-action: none;
        cursor: crosshair;
      }
      /* The console bar: a fixed anchor along the bottom edge. */
      #sf-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        gap: clamp(0.75rem, 3vw, 2rem);
        padding: 0.75rem max(1.25rem, env(safe-area-inset-right)) max(0.9rem, env(safe-area-inset-bottom))
          max(1.25rem, env(safe-area-inset-left));
        background: linear-gradient(to top, rgb(0 0 0 / 0.9), rgb(0 0 0 / 0));
        z-index: 3;
      }
      #sf-brand {
        flex: none;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
      }
      .sf-wordmark {
        color: var(--sf-text);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-decoration: none;
        opacity: 0.55;
        white-space: nowrap;
        transition: opacity 160ms ease;
      }
      #sf-nav {
        display: flex;
        gap: 0.7rem;
      }
      #sf-nav a {
        color: var(--sf-dim);
        font-size: 0.62rem;
        letter-spacing: 0.1em;
        text-decoration: none;
        transition: color 160ms ease;
      }
      .sf-wordmark:hover,
      .sf-wordmark:focus-visible,
      #sf-nav a:hover,
      #sf-nav a:focus-visible {
        opacity: 1;
        color: var(--sf-link);
      }
      #sf-tuner {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      #sf-dial {
        position: relative;
        height: 26px;
        cursor: ew-resize;
        touch-action: none;
        border-top: 1px solid rgb(255 255 255 / 0.14);
        border-bottom: 1px solid rgb(255 255 255 / 0.14);
        background-image: repeating-linear-gradient(
          90deg,
          rgb(255 255 255 / 0.22) 0 1px,
          transparent 1px 15px
        );
      }
      #sf-needle {
        position: absolute;
        top: -3px;
        bottom: -3px;
        left: 0;
        width: 2px;
        background: var(--sf-ember);
        box-shadow: 0 0 6px 1px rgb(250 158 61 / 0.7);
        pointer-events: none;
        transition: left 90ms linear;
      }
      #sf-readout {
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--sf-dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      #sf-controls {
        flex: none;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      #sf-dial:focus-visible {
        outline: 2px solid var(--sf-link);
        outline-offset: 3px;
      }
      #sf-sound {
        appearance: none;
        background: transparent;
        border: 1px solid rgb(255 255 255 / 0.18);
        color: var(--sf-text);
        font-family: var(--sf-mono);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        padding: 0.5rem 0.7rem;
        min-height: 44px;
        cursor: pointer;
        opacity: 0.55;
        transition: opacity 160ms ease;
      }
      #sf-volume {
        width: 90px;
        accent-color: var(--sf-ember);
      }
      #sf-sound:hover,
      #sf-sound:focus-visible {
        opacity: 0.9;
      }
      .sf-wordmark:focus-visible,
      #sf-nav a:focus-visible,
      #sf-sound:focus-visible,
      #sf-focus a:focus-visible,
      #sf-fallback a:focus-visible {
        outline: 2px solid var(--sf-link);
        outline-offset: 2px;
      }
      #sf-focus {
        position: fixed;
        max-width: min(26rem, calc(100vw - 2rem));
        padding: 0.9rem 1rem;
        background: rgb(0 0 0 / 0.9);
        border: 1px solid rgb(255 255 255 / 0.18);
        font-size: 0.8rem;
        line-height: 1.5;
        z-index: 4;
      }
      #sf-focus .sf-focus-kind {
        display: block;
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        color: var(--sf-ember);
        margin-bottom: 0.35rem;
      }
      #sf-focus .sf-focus-title {
        display: block;
        margin-bottom: 0.6rem;
      }
      #sf-focus .sf-focus-note {
        display: block;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        color: var(--sf-dim);
      }
      #sf-focus a {
        display: inline-block;
        min-height: 44px;
        line-height: 44px;
        padding: 0 0.25rem;
        color: var(--sf-link);
        letter-spacing: 0.12em;
        text-decoration: none;
      }
      #sf-focus a:hover,
      #sf-focus a:focus-visible {
        text-decoration: underline;
      }
      #sf-fallback {
        position: fixed;
        inset: 0;
        overflow-y: auto;
        padding: clamp(1.5rem, 6vw, 4rem);
        z-index: 1;
      }
      .sf-panel-heading {
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        color: var(--sf-dim);
        margin: 0 0 1.5rem;
        max-width: 34rem;
        line-height: 1.7;
      }
      .sf-panel-list {
        list-style: none;
        margin: 0;
        padding: 0;
        max-width: 34rem;
      }
      .sf-panel-list li {
        margin-bottom: 0.9rem;
        font-size: 0.8rem;
        line-height: 1.55;
      }
      .sf-panel-list a {
        color: var(--sf-link);
        text-decoration: none;
      }
      .sf-panel-list a:hover,
      .sf-panel-list a:focus-visible {
        text-decoration: underline;
      }
      .sf-panel-list .sf-kind {
        display: block;
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        color: var(--sf-ember);
      }
      noscript .sf-panel-heading {
        position: fixed;
        top: clamp(1.5rem, 6vw, 4rem);
        left: clamp(1.5rem, 6vw, 4rem);
      }
      noscript a {
        color: var(--sf-link);
      }
    </style>
  </head>
  <body>
    <canvas id="sf-canvas" aria-hidden="true"></canvas>
    <div id="sf-bar">
      <div id="sf-brand">
        <a class="sf-wordmark" href="/">NORTHERN INFORMATION</a>
        <nav id="sf-nav" aria-label="Site">
          <a href="/projects/">Projects</a>
          <a href="/music/">Music</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
        </nav>
      </div>
      <div id="sf-tuner">
        <div
          id="sf-dial"
          role="slider"
          tabindex="0"
          aria-label="Tune the band"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <div id="sf-needle"></div>
        </div>
        <div id="sf-readout" aria-live="polite">— static —</div>
      </div>
      <div id="sf-controls">
        <input
          id="sf-volume"
          type="range"
          min="0"
          max="1"
          step="0.01"
          aria-label="Signal volume"
          hidden
        />
        <button id="sf-sound" type="button" aria-pressed="false">
          [ turn on the signal ]
        </button>
      </div>
    </div>
    <div id="sf-focus" hidden></div>
    <section id="sf-fallback" hidden aria-label="Archive stations"></section>
    <noscript>
      <p class="sf-panel-heading">
        SHADOW FI — this instrument requires script execution. The signal will
        not resolve. The records remain: <a href="/music/">the music</a>.
      </p>
    </noscript>
    <script
      type="module"
      src="/scripts/shadow-fi/main.js?ver={% getTimestamp %}"
    ></script>
  </body>
</html>
