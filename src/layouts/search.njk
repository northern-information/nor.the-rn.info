---
layout: base.njk
---
<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">
<link rel="stylesheet" href="/styles/pagefind.css?ver={% getTimestamp %}">
<script type="module" src="/pagefind/pagefind-component-ui.js"></script>
<h1 class="sr-only">{{ title }}</h1>
<div class="overflow-hidden border-4 border-solid border-black p-2 pb-10 text-center">
  <p class="font-mono">
    Search the entire Northern Information site.
    <br>
    Last indexed: {{ site.META.BUILD_TIME | dateToUTCFull }}
    <br>
  </p>
  <p>&#8258;</p>
  <noscript>
    <p class="py-4 text-center">JavaScript is required for search.</p>
  </noscript>
  {#- The base plugin does not rewrite these attributes, so add the prefix here. #}
  <pagefind-config
    bundle-path="{{ site.META.PATH_PREFIX }}pagefind/"
    base-url="{{ site.META.PATH_PREFIX }}"
  ></pagefind-config>
  <div id="search" class="search">
    <pagefind-input placeholder="Search"></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </div>
</div>
