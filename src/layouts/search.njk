---
layout: base.njk
---
<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">
<link rel="stylesheet" href="/styles/pagefind.css?ver={% getTimestamp %}">
<script type="module" src="/pagefind/pagefind-component-ui.js"></script>
<h1 class="sr-only">{{ title }}</h1>
<div class="mx-auto max-w-3xl px-2 pt-6 pb-16">
  <p class="mb-4 font-mono text-xs text-gray-400">
    Index built {{ site.META.BUILD_TIME | dateToUTCFull }}
  </p>
  <noscript>
    <p class="font-mono text-sm">JavaScript is required for search.</p>
  </noscript>
  {#- The base plugin does not rewrite these attributes, so add the prefix here. #}
  <pagefind-config
    bundle-path="{{ site.META.PATH_PREFIX }}pagefind/"
    base-url="{{ site.META.PATH_PREFIX }}"
    excerpt-length="24"
  ></pagefind-config>
  <div class="search">
    <pagefind-input placeholder="Search"></pagefind-input>
    {#- Components reset their own margins, so space them with wrappers. #}
    <div class="mt-2 mb-1">
      <pagefind-summary></pagefind-summary>
    </div>
    <pagefind-results max-sub-results="2">
      {#- Pagefind templates use {{ }} too, so Nunjucks must not render them.
          Template markup inherits `all: initial`, so set font and color on it.
          The title link's ::after covers the whole result, so all of it is
          clickable. Section links are z-10 to sit above it. -#}
      {% raw %}
      <script type="text/pagefind-template">
        <li class="group relative -mx-2 border-t border-stone-800 px-2 py-3 font-sans text-stone-100 hover:bg-stone-900">
          <a href="{{ meta.url | default(url) | safeUrl }}" class="text-base leading-tight font-semibold text-yellow-300 underline decoration-1 underline-offset-2 group-hover:text-yellow-500 group-hover:no-underline after:absolute after:inset-0">{{ meta.title }}</a>
          {{#if excerpt}}
          <p class="search-excerpt mt-1 line-clamp-2 text-sm leading-snug text-stone-300">{{+ excerpt +}}</p>
          {{/if}}
          {{#if sub_results}}
          <ul>
            {{#each sub_results as sub}}
            {{#if ne(sub.title, meta.title)}}
            <li class="mt-1 truncate border-l border-stone-700 pl-2 font-mono text-xs leading-5">
              <a href="{{ sub.url | safeUrl }}" class="relative z-10 text-stone-300 underline decoration-stone-600 underline-offset-2 hover:text-yellow-300">§ {{ sub.title }}</a>
            </li>
            {{/if}}
            {{/each}}
          </ul>
          {{/if}}
        </li>
      </script>
      <script type="text/pagefind-template" data-template="placeholder">
        <li aria-hidden="true" class="border-t border-stone-800 py-3">
          <div class="h-4 w-1/2 bg-stone-800"></div>
          <div class="mt-2 h-3 w-5/6 bg-stone-900"></div>
        </li>
      </script>
      {% endraw %}
    </pagefind-results>
  </div>
</div>
