---
layout: base.njk
---
<div class="my-1 grid grid-cols-1 overflow-hidden md:grid-cols-2">
  <div class="w-full">
    <a href="/images/tyler-etters-261031.webp" class="grain block overflow-hidden">
      <img
        src="/images/tyler-etters-261031.webp"
        alt="Tyler Etters performing at a table of gear under purple stage light"
        class="h-auto w-full"
        sizes="(min-width: 1536px) 768px, (min-width: 768px) 50vw, 100vw"
        eleventy:widths="400,800,1600,2400,3200"
        eleventy:formats="avif,webp,jpeg"
      >
    </a>
  </div>
  <div class="post pt-3 pl-2">
    {{ content | safe }}
    <p>Contact: <a href="mailto:tyler@etters.co">tyler@etters.co</a>, 
      {% for account in site.ACCOUNTS -%}
        <a href="{{ account.url }}">{{ account.label }}</a>{% if loop.revindex == 2 %}, or {% elif not loop.last %}, {% endif %}
      {%- endfor %}.
    </p>
    <p>Old about images: <a href="/about/photos/">here</a>.</p>
  </div>
</div>
